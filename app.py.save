# ==================== ATTENDANCE (with Class Filter) ====================
@app.route('/attendance')
@login_required
def attendance():
    class_filter = request.args.get('class', '')
    conn = get_db()
    classes = conn.execute("SELECT DISTINCT class_name FROM students ORDER BY class_name").fetchall()
    if class_filter:
        students = conn.execute("SELECT id, name, admission_no, class_name FROM students WHERE class_name=? ORDER BY name", (class_filter,)).fetchall()
    else:
        students = conn.execute("SELECT id, name, admission_no, class_name FROM students ORDER BY class_name, name").fetchall()
    conn.close()

    class_options = '<option value="">All Classes</option>' + "".join([f'<option value="{c["class_name"]}" {"selected" if c["class_name"]==class_filter else ""}>{c["class_name"]}</option>' for c in classes])

    form = f'''
    <form method="GET" style="margin-bottom:12px;">
        <label>Filter by Class: </label>
        <select name="class" onchange="this.form.submit()">{class_options}</select>
    </form>
    <form method="POST" action="/save_attendance">
        <p>Date: <input type="date" name="date" value="{datetime.now().strftime('%Y-%m-%d')}" required></p>
        <table>
            <tr><th>Adm No</th><th>Name</th><th>Class</th><th>Status</th></tr>
    '''
    for s in students:
        form += f'''<tr>
            <td>{s['admission_no']}</td>
            <td>{s['name']}</td>
            <td>{s['class_name']}</td>
            <td>
                <select name="status_{s['id']}">
                    <option>Present</option>
                    <option>Absent</option>
                    <option>Late</option>
                </select>
            </td>
        </tr>'''
    for s in students:
        form += f'''<tr>
            <td>{s['admission_no']}</td>
            <td>{s['name']}</td>
            <td>{s['class_name']}</td>
            <td>
                <select name="status_{s['id']}">
                    <option>Present</option>
                    <option>Absent</option>
                    <option>Late</option>
                </select>
            </td>
        </tr>'''
    form += '</table><br><button type="submit">Save Attendance</button></form>'

    content = f'''
    <div class="card">
        <h2>Mark Attendance</h2>
        {form}
        <br>
        <a class="btn btn-success" href="/export/attendance">Export Attendance</a>
    </div>
    '''
    return render_template_string(BASE, content=content)

@app.route('/save_attendance', methods=['POST'])
@login_required
def save_attendance():
    date = request.form['date']
    conn = get_db()
    for key in request.form:
        if key.startswith('status_'):
            sid = key.split('_')[1]
            conn.execute("INSERT INTO attendance (student_id, date, status) VALUES (?,?,?)",
                         (sid, date, request.form[key]))
    conn.commit()
    conn.close()
    flash("Attendance saved!")
    return redirect(url_for('attendance'))
