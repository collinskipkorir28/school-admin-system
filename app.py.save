@app.route('/results')
@login_required
def results():
    conn = get_db()
    students = conn.execute("SELECT id, name, admission_no FROM students").fetchall()
    rows = conn.execute('''SELECT r.*, s.name, s.admission_no FROM results r 
                           JOIN students s ON r.student_id = s.id ORDER BY r.id DESC LIMIT 100''').fetchall()
    conn.close()
    options = "".join([f"<option value='{s['id']}'>{s['admission_no']} - {s['name']}</option>" for s in students])
    table = "<table><tr><th>Adm No</th><th>Name</th><th>Subject</th><th>Marks</th><th>Term</th><th>Year</th></tr>"
    for r in rows:
        table += f"<tr><td>{r['admission_no']}</td><td>{r['name']}</td><td>{r['subject']}</td><td>{r['marks']}</td><td>{r['term']}</td><td>{r['year']}</td></tr>"
    table += "</table>"
    content = f'''
    <div class="card">
        <h2>Exam Results</h2>
        <form method="POST" action="/add_result">
            <div class="form-row">
                <select name="student_id" required>{options}</select>
                <input name="subject" placeholder="Subject" required>
                <input name="marks" type="number" step="0.01" placeholder="Marks" required>
                <input name="term" placeholder="Term" required>
                <input name="year" value="{datetime.now().year}" required>
                <button type="submit">Add Result</button>
            </div>
        </form>
        <h3>Recent Results</h3>{table}
        <br><a class="btn btn-success" href="/export/results">Export to Excel</a>
    </div>
    '''
    return render_template_string(BASE, content=content)

@app.route('/add_result', methods=['POST'])
@login_required
def add_result():
    conn = get_db()
    conn.execute("INSERT INTO results (student_id, subject, marks, term, year) VALUES (?,?,?,?,?)",
                 (request.form['student_id'], request.form['subject'], request.form['marks'],
                  request.form['term'], request.form['year']))
    conn.commit()
    conn.close()
    flash("Result added!")
    return redirect(url_for('results'))

# ==================== FEES ====================
@app.route('/fees')
@login_required
def fees():
    conn = get_db()
    students = conn.execute("SELECT id, name, admission_no FROM students").fetchall()
    rows = conn.execute('''SELECT f.*, s.name, s.admission_no FROM fees f 
                           JOIN students s ON f.student_id = s.id ORDER BY f.id DESC LIMIT 100''').fetchall()
    conn.close()
    options = "".join([f"<option value='{s['id']}'>{s['admission_no']} - {s['name']}</option>" for s in students])
    table = "<table><tr><th>Adm No</th><th>Name</th><th>Amount</th><th>Paid On</th><th>Term</th><th>Year</th></tr>"
    for r in rows:
        table += f"<tr><td>{r['admission_no']}</td><td>{r['name']}</td><td>{r['amount']}</td><td>{r['paid_on']}</td><td>{r['term']}</td><td>{r['year']}</td></tr>"
    table += "</table>"
    content = f'''
    <div class="card">
        <h2>Fee Collection</h2>
        <form method="POST" action="/add_fee">
            <div class="form-row">
                <select name="student_id" required>{options}</select>
                <input name="amount" type="number" step="0.01" placeholder="Amount" required>
                <input name="term" placeholder="Term" required>
                <input name="year" value="{datetime.now().year}" required>
                <button type="submit">Record Payment</button>
            </div>
        </form>
        <h3>Recent Payments</h3>{table}
        <br><a class="btn btn-success" href="/export/fees">Export to Excel</a>
    </div>
    '''
    return render_template_string(BASE, content=content)

@app.route('/add_fee', methods=['POST'])
@login_required
def add_fee():
    conn = get_db()
    conn.execute("INSERT INTO fees (student_id, amount, paid_on, term, year) VALUES (?,?,?,?,?)",
                 (request.form['student_id'], request.form['amount'],
                  datetime.now().strftime("%Y-%m-%d"), request.form['term'], request.form['year']))
    conn.commit()
    conn.close()
    flash("Fee recorded!")
    return redirect(url_for('fees'))
# ==================== REPORTS + CHARTS ====================
@app.route('/reports')
@login_required
def reports():
    conn = get_db()
    att = conn.execute("SELECT status, COUNT(*) as cnt FROM attendance GROUP BY status").fetchall()
    fees_m = conn.execute("SELECT strftime('%Y-%m', paid_on) as month, SUM(amount) as total FROM fees GROUP BY month ORDER BY month").fetchall()
    avg_marks = conn.execute("SELECT subject, AVG(marks) as avg FROM results GROUP BY subject").fetchall()
    conn.close()

    def make_chart(labels, values, title, kind='bar'):
        plt.figure(figsize=(7, 3.6))
        if kind == 'pie':
            plt.pie(values, labels=labels, autopct='%1.1f%%', startangle=90)
        else:
            plt.bar(labels, values, color='#1a73e8')
            plt.xticks(rotation=40, ha='right')
        plt.title(title)
        plt.tight_layout()
        buf = io.BytesIO()
        plt.savefig(buf, format='png', dpi=100)
        buf.seek(0)
        img = base64.b64encode(buf.read()).decode('utf-8')
        plt.close()
        return f'<img class="chart" src="data:image/png;base64,{img}">'

    att_chart = make_chart([a['status'] for a in att], [a['cnt'] for a in att], "Attendance Overview", 'pie') if att else "<p>No attendance data yet</p>"
    fee_chart = make_chart([f['month'] for f in fees_m], [f['total'] for f in fees_m], "Fees Collected by Month") if fees_m else "<p>No fee data yet</p>"
    marks_chart = make_chart([m['subject'] for m in avg_marks], [m['avg'] for m in avg_marks], "Average Marks by Subject") if avg_marks else "<p>No results data yet</p>"

    content = f'''
    <div class="card">
        <h2>Reports & Charts</h2>
        <h3>Attendance Overview</h3>{att_chart}
        <h3>Fees Collection Trend</h3>{fee_chart}
        <h3>Average Marks by Subject</h3>{marks_chart}
    </div>
    '''
    return render_template_string(BASE, content=content)

# ==================== EXPORT ====================
@app.route('/export/<table>')
@login_required
def export(table):
    conn = get_db()
    if table == 'students':
        df = pd.read_sql_query("SELECT * FROM students", conn)
    elif table == 'results':
        df = pd.read_sql_query('''SELECT s.admission_no, s.name, r.subject, r.marks, r.term, r.year 
                                  FROM results r JOIN students s ON r.student_id = s.id''', conn)
    elif table == 'fees':
        df = pd.read_sql_query('''SELECT s.admission_no, s.name, f.amount, f.paid_on, f.term, f.year 
                                  FROM fees f JOIN students s ON f.student_id = s.id''', conn)
    elif table == 'attendance':
        df = pd.read_sql_query('''SELECT s.admission_no, s.name, a.date, a.status 
                                  FROM attendance a JOIN students s ON a.student_id = s.id''', conn)
    else:
        conn.close()
        return "Invalid", 400
    conn.close()
    output = io.BytesIO()
    with pd.ExcelWriter(output, engine='openpyxl') as writer:
        df.to_excel(writer, index=False, sheet_name=table.capitalize())
    output.seek(0)
    return send_file(output, download_name=f"{table}_{datetime.now().strftime('%Y%m%d')}.xlsx",
                     as_attachment=True, mimetype='application/vnd.openxmlformats-officedocument.spreadsheetml.sheet')

