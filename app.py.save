# ==================== LOGIN ====================
@app.route('/login', methods=['GET', 'POST'])
def login():
    if session.get('logged_in'):
        return redirect(url_for('dashboard'))
    if request.method == 'POST':
        conn = get_db()
        user = conn.execute("SELECT * FROM users WHERE username=?", (request.form['username'],)).fetchone()
        conn.close()
        if user and user['password'] == hash_password(request.form['password']):
            session['logged_in'] = True
            session['username'] = user['username']
            flash("Welcome back!")
            return redirect(url_for('dashboard'))
        else:
            flash("Wrong username or password")
    content = '''
    <div class="card" style="max-width:380px;margin:50px auto;">
        <h2 style="text-align:center;">School Admin Login</h2>
        <form method="POST">
            <input name="username" placeholder="Username" required style="width:100%; margin-bottom:8px;"><br>
            <input name="password" type="password" placeholder="Password" required style="width:100%; margin-bottom:8px;"><br>
            <button type="submit" style="width:100%;">Login</button>
        </form>
        <p style="text-align:center;color:#666;font-size:13px;margin-top:14px;">Default: admin / admin123</p>
    </div>
    '''
    return render_template_string(BASE, content=content)

@app.route('/logout')
def logout():
    session.clear()
    return redirect(url_for('login'))

# ==================== CHANGE PASSWORD ====================
@app.route('/change_password', methods=['GET', 'POST'])
@login_required
def change_password():
    if request.method == 'POST':
        current = request.form['current']
        new_pass = request.form['new_pass']
        confirm = request.form['confirm']
        conn = get_db()
        user = conn.execute("SELECT * FROM users WHERE username=?", (session.get('username'),)).fetchone()
        if not user or user['password'] != hash_password(current):
            flash("Current password is incorrect")
        elif new_pass != confirm:
            flash("New passwords do not match")
        elif len(new_pass) < 5:
            flash("Password must be at least 5 characters")
        else:
            conn.execute("UPDATE users SET password=? WHERE username=?", (hash_password(new_pass), session.get('username')))
            conn.commit()
            flash("Password changed successfully!")
            conn.close()
            return redirect(url_for('dashboard'))
        conn.close()
    content = '''
    <div class="card" style="max-width:420px;margin:30px auto;">
        <h2>Change Password</h2>
        <form method="POST">
            <input name="current" type="password" placeholder="Current Password" required style="width:100%;margin-bottom:8px;"><br>
            <input name="new_pass" type="password" placeholder="New Password" required style="width:100%;margin-bottom:8px;"><br>
            <input name="confirm" type="password" placeholder="Confirm New Password" required style="width:100%;margin-bottom:8px;"><br>
            <button type="submit" style="width:100%;">Update Password</button>
        </form>
    </div>
    '''
    return render_template_string(BASE, content=content)

# ==================== DASHBOARD ====================
@app.route('/')
@login_required
def dashboard():
    conn = get_db()
    students = conn.execute("SELECT COUNT(*) FROM students").fetchone()[0]
    teachers = conn.execute("SELECT COUNT(*) FROM teachers").fetchone()[0]
    today = datetime.now().strftime("%Y-%m-%d")
    present = conn.execute("SELECT COUNT(*) FROM attendance WHERE date=? AND status='Present'", (today,)).fetchone()[0]
    total_fees = conn.execute("SELECT COALESCE(SUM(amount),0) FROM fees").fetchone()[0]
    conn.close()
    content = f'''
    <div class="card">
        <h1>Dashboard</h1>
        <div class="stats">
            <div class="stat-box"><h3>{students}</h3><p>Students</p></div>
            <div class="stat-box"><h3>{teachers}</h3><p>Teachers</p></div>
            <div class="stat-box"><h3>{present}</h3><p>Present Today</p></div>
            <div class="stat-box"><h3>{total_fees:,.0f}</h3><p>Fees Collected</p></div>
        </div>
    </div>
    '''
    return render_template_string(BASE, content=content)

# ==================== STUDENTS ====================
@app.route('/students')
@login_required
def students():
    q = request.args.get('q', '').strip()
    conn = get_db()
    if q:
        rows = conn.execute('''SELECT * FROM students 
            WHERE name LIKE ? OR admission_no LIKE ? OR class_name LIKE ? OR parent_phone LIKE ?
            ORDER BY id DESC''', (f'%{q}%', f'%{q}%', f'%{q}%', f'%{q}%')).fetchall()
    else:
        rows = conn.execute("SELECT * FROM students ORDER BY id DESC").fetchall()
    conn.close()

    table = "<table><tr><th>Adm No</th><th>Name</th><th>Gender</th><th>Class</th><th>Phone</th><th>Actions</th></tr>"
    for r in rows:
        table += f'''<tr>
            <td>{r['admission_no']}</td>
            <td>{r['name']}</td>
            <td>{r['gender']}</td>
            <td>{r['class_name']}</td>
            <td>{r['parent_phone']}</td>
            <td>
                <a class="btn btn-sm" href="/student/{r['id']}">Profile</a>
                <a class="btn btn-sm btn-danger" href="javascript:confirmDelete('/delete_student/{r['id']}')">Delete</a>
            </td>
        </tr>'''
    table += "</table>"

    content = f'''
    <div class="card">
        <h2>Students</h2>
        <div class="search-box">
            <form method="GET" style="display:flex;flex-wrap:wrap;gap:6px;width:100%;">
                <input name="q" value="{q}" placeholder="Search name, admission no, class..." style="flex:1;min-width:180px;">
                <button type="submit">Search</button>
                <a class="btn" href="/students">Clear</a>
            </form>
        </div>
        <form method="POST" action="/add_student">
            <div class="form-row">
                <input name="admission_no" placeholder="Admission No" required>
                <input name="name" placeholder="Full Name" required>
                <select name="gender"><option>Male</option><option>Female</option></select>
                <input name="class_name" placeholder="Class (e.g. Form 2A)" required>
                <input name="parent_phone" placeholder="Parent Phone">
                <input name="address" placeholder="Address">
                <button type="submit">Add Student</button>
            </div>
        </form>
        {table}
        <br>
        <a class="btn btn-success" href="/export/students">Export to Excel</a>
    </div>
    '''
    return render_template_string(BASE, content=content)

@app.route('/add_student', methods=['POST'])
@login_required
def add_student():
    conn = get_db()
    try:
        conn.execute("INSERT INTO students (admission_no, name, gender, class_name, parent_phone, address, created_at) VALUES (?,?,?,?,?,?,?)",
                     (request.form['admission_no'], request.form['name'], request.form['gender'],
                      request.form['class_name'], request.form['parent_phone'], request.form['address'],
                      datetime.now().strftime("%Y-%m-%d")))
        conn.commit()
        flash("Student added successfully!")
    except:
        flash("Error: Admission number already exists")
    conn.close()
    return redirect(url_for('students'))

@app.route('/delete_student/<int:id>')
@login_required
def delete_student(id):
    conn = get_db()
    conn.execute("DELETE FROM students WHERE id=?", (id,))
    conn.commit()
    conn.close()
    flash("Student deleted")
    return redirect(url_for('students'))

# ==================== STUDENT PROFILE + PRINTABLE REPORT CARD ====================
@app.route('/student/<int:id>')
@login_required
def student_profile(id):
    conn = get_db()
    student = conn.execute("SELECT * FROM students WHERE id=?", (id,)).fetchone()
    if not student:
        flash("Student not found")
        return redirect(url_for('students'))
    attendance = conn.execute("SELECT * FROM attendance WHERE student_id=? ORDER BY date DESC LIMIT 40", (id,)).fetchall()
    results = conn.execute("SELECT * FROM results WHERE student_id=? ORDER BY year DESC, term", (id,)).fetchall()
    fees = conn.execute("SELECT * FROM fees WHERE student_id=? ORDER BY paid_on DESC", (id,)).fetchall()
    total_paid = conn.execute("SELECT COALESCE(SUM(amount),0) FROM fees WHERE student_id=?", (id,)).fetchone()[0]
    conn.close()

    att_rows = "".join([f"<tr><td>{a['date']}</td><td>{a['status']}</td></tr>" for a in attendance]) or "<tr><td colspan='2'>No records</td></tr>"
    res_rows = "".join([f"<tr><td>{r['subject']}</td><td>{r['marks']}</td><td>{r['term']}</td><td>{r['year']}</td></tr>" for r in results]) or "<tr><td colspan='4'>No results</td></tr>"
    fee_rows = "".join([f"<tr><td>{f['amount']}</td><td>{f['paid_on']}</td><td>{f['term']}</td><td>{f['year']}</td></tr>" for f in fees]) or "<tr><td colspan='4'>No payments</td></tr>"

    content = f'''
    <div class="card">
        <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;">
            <h2>Student Profile</h2>
            <div class="no-print">
                <a class="btn btn-warning" href="/report_card/{id}" target="_blank">Print Report Card</a>
                <a class="btn" href="/students">← Back</a>
            </div>
        </div>
        <p><strong>Admission No:</strong> {student['admission_no']}<br>
        <strong>Name:</strong> {student['name']}<br>
        <strong>Gender:</strong> {student['gender']}<br>
        <strong>Class:</strong> {student['class_name']}<br>
        <strong>Parent Phone:</strong> {student['parent_phone']}<br>
        <strong>Address:</strong> {student['address']}<br>
        <strong>Total Fees Paid:</strong> {total_paid:,.0f}</p>
    </div>
    <div class="profile-grid">
        <div class="card">
            <h3>Recent Attendance</h3>
            <table><tr><th>Date</th><th>Status</th></tr>{att_rows}</table>
        </div>
        <div class="card">
            <h3>Exam Results</h3>
            <table><tr><th>Subject</th><th>Marks</th><th>Term</th><th>Year</th></tr>{res_rows}</table>
        </div>
    </div>
    <div class="card">
        <h3>Fee Payments</h3>
        <table><tr><th>Amount</th><th>Paid On</th><th>Term</th><th>Year</th></tr>{fee_rows}</table>
    </div>
    '''
    return render_template_string(BASE, content=content)

@app.route('/report_card/<int:id>')
@login_required
def report_card(id):
    conn = get_db()
    student = conn.execute("SELECT * FROM students WHERE id=?", (id,)).fetchone()
    results = conn.execute("SELECT * FROM results WHERE student_id=? ORDER BY year DESC, term, subject", (id,)).fetchall()
    total_paid = conn.execute("SELECT COALESCE(SUM(amount),0) FROM fees WHERE student_id=?", (id,)).fetchone()[0]
    conn.close()
    if not student:
        return "Student not found", 404

    res_rows = "".join([f"<tr><td>{r['subject']}</td><td>{r['marks']}</td><td>{r['term']}</td><td>{r['year']}</td></tr>" for r in results]) or "<tr><td colspan='4'>No results recorded</td></tr>"

    html = f'''
    <!DOCTYPE html>
    <html>
    <head>
        <title>Report Card - {student['name']}</title>
        <style>
            body {{ font-family: Arial, sans-serif; padding: 30px; max-width: 800px; margin: auto; }}
            h1, h2 {{ text-align: center; color: #1a73e8; }}
            table {{ width: 100%; border-collapse: collapse; margin-top: 20px; }}
            th, td {{ border: 1px solid #333; padding: 8px; text-align: left; }}
            th {{ background: #1a73e8; color: white; }}
            .info {{ margin: 20px 0; line-height: 1.7; }}
            @media print {{ button {{ display: none; }} }}
        </style>
    </head>
    <body>
        <h1>SCHOOL REPORT CARD</h1>
        <h2>{student['name']}</h2>
        <div class="info">
            <strong>Admission No:</strong> {student['admission_no']}<br>
            <strong>Class:</strong> {student['class_name']}<br>
            <strong>Gender:</strong> {student['gender']}<br>
            <strong>Parent Phone:</strong> {student['parent_phone']}<br>
            <strong>Total Fees Paid:</strong> {total_paid:,.0f}<br>
            <strong>Date Generated:</strong> {datetime.now().strftime("%d %B %Y")}
        </div>
        <h3>Academic Results</h3>
        <table>
            <tr><th>Subject</th><th>Marks</th><th>Term</th><th>Year</th></tr>
            {res_rows}
        </table>
        <br><br>
        <button onclick="window.print()" style="padding:10px 20px;font-size:16px;">Print Report Card</button>
    </body>
    </html>
    '''
    return html

